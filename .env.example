# Salin file ini menjadi .env (tidak masuk git), lalu isi password database.
# Supabase → Connect → Direct → Session pooler (IPv4). Password: Supabase → Project Settings → Database.
# Password berisi karakter khusus (@ : / # ? %) → tulis versi percent-encoded, mis. @ → %40.
DATABASE_URL=postgresql://postgres.infgrmdyhlbqzzbxbton:ISI_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Hanya di laptop sendiri: lewati halaman login. JANGAN diisi di hosting.
DEV_NO_LOGIN=true

# Opsional, hanya untuk tools/migrate-from-mysql.php (memindahkan data dari MySQL lama)
MYSQL_URL=mysql://root@127.0.0.1:3306/management_hub
